import java.util.*;

public class Student {

    int result(int m1, int m2, int m3) {
        return m1 + m2 + m3;
    }

    float result(float m1, float m2) {
        return m1 + m2;
    }

    public static void main(String[] args) {

        Student s = new Student();

        System.out.println(s.result(2, 3, 4));
        System.out.println(s.result(4.5f, 5.5f));
    }
}
