import java.util.*;
public class Main {
    public static void main(String args[]) {
        Scanner sc=new Scanner(System.in);
        int bin=sc.nextInt();

        int dec=0,pow=1;

        while(bin>0){
            int rem=bin%10;
            dec=dec+rem*pow;
            pow=pow*2;
            bin=bin/10;
        }

        System.out.println(dec);
    }
}
